# Sitio nginx de La Liga ACP para el nginx del HOST (fuera de Docker).
#
# Hace dos cosas y nada más: pone el dominio y el certificado, y reenvía TODO a
# la pila de Docker, que escucha solo en el loopback (compose.prod.yaml,
# servicio `web`, 127.0.0.1:8080). Dentro del contenedor otro nginx sirve la
# SPA y pasa /api al backend (deploy/web/nginx.conf), así que acá no hay
# dist/, ni rutas de la SPA, ni proxy a la API: no hace falta Node en el host.
#
# Pasos completos, en el orden real: README, "Despliegue en servidor propio".
#
# Copiar, reemplazar los marcadores y activar:
#   sudo cp deploy/nginx/la-liga-acp.conf.example /etc/nginx/sites-available/la-liga-acp.conf
#   sudo sed -i 's|DOMINIO\.EJEMPLO|liga.tu-dominio.com|g' /etc/nginx/sites-available/la-liga-acp.conf
#   sudo sed -i 's|/RUTA/AL/CERTIFICADO/fullchain.pem|/etc/ssl/la-liga-acp/fullchain.pem|' /etc/nginx/sites-available/la-liga-acp.conf
#   sudo sed -i 's|/RUTA/AL/CERTIFICADO/privkey.pem|/etc/ssl/la-liga-acp/privkey.pem|'     /etc/nginx/sites-available/la-liga-acp.conf
#   sudo ln -s /etc/nginx/sites-available/la-liga-acp.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Marcadores:
#   DOMINIO.EJEMPLO          el dominio (DOS veces: bloque HTTP y HTTPS). Es el
#                            mismo que CORS_ORIGIN del .env, que lleva https://.
#   /RUTA/AL/CERTIFICADO/... tu certificado (cadena completa) y su clave privada.
#   127.0.0.1:8080           el puerto de `web`. 8080 es el valor por defecto de
#                            WEB_PORT; si se cambia en el .env, cambiarlo acá.
#
# El certificado tiene que existir ANTES de activar el sitio: si los archivos
# no están, `nginx -t` falla y nginx no recarga.

# ---------------------------------------------------------------------------
# HTTP: solo redirige a HTTPS. La app NO funciona por HTTP: con
# NODE_ENV=production la cookie de sesión es Secure y con prefijo __Host-, y el
# navegador la descarta sin TLS. Nadie podría iniciar sesión.
# ---------------------------------------------------------------------------
server {
	listen 80;
	listen [::]:80;
	server_name DOMINIO.EJEMPLO;

	# Para renovar con certbot en modo webroot. Va antes del redirect.
	location ^~ /.well-known/acme-challenge/ {
		root /var/www/html;
	}

	location / {
		return 301 https://$host$request_uri;
	}
}

# ---------------------------------------------------------------------------
# HTTPS: termina el TLS y reenvía todo al contenedor `web`.
# ---------------------------------------------------------------------------
server {
	listen 443 ssl;
	listen [::]:443 ssl;
	# nginx 1.25.1 o posterior. En versiones anteriores borrar esta línea y
	# poner `listen 443 ssl http2;` arriba (`nginx -v` dice la versión).
	http2 on;
	server_name DOMINIO.EJEMPLO;

	ssl_certificate     /RUTA/AL/CERTIFICADO/fullchain.pem;
	ssl_certificate_key /RUTA/AL/CERTIFICADO/privkey.pem;

	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_prefer_server_ciphers off;
	ssl_session_cache shared:SSL:10m;
	ssl_session_timeout 1d;

	# Imágenes del panel: hasta 5 MiB más el sobre multipart. El default de
	# nginx (1 MiB) corta casi cualquier foto con un 413.
	client_max_body_size 6m;

	server_tokens off;

	# HSTS: el navegador recuerda que el dominio es solo HTTPS. Difícil de
	# revertir mientras no venza (un año): conviene activarlo con el HTTPS ya
	# firme, o probar antes con max-age=300. Si no se quiere, borrar la línea.
	# Las demás cabeceras (Cache-Control, nosniff) las pone el contenedor.
	add_header Strict-Transport-Security "max-age=31536000" always;

	location / {
		# Sin barra ni ruta después del puerto: la URL llega tal cual, cruda,
		# con su query. El contenedor decide qué es SPA, qué es archivo y qué
		# es /api.
		proxy_pass http://127.0.0.1:8080;

		proxy_http_version 1.1;
		proxy_set_header Connection "";
		proxy_set_header Host $host;
		# La IP real del cliente. El backend la lee con TRUST_PROXY=2 (este
		# nginx y el del contenedor): de eso dependen los límites de intentos.
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;

		# Las respuestas de la app (404 con su página, errores de la API con su
		# sobre { error }) pasan tal cual.
		proxy_intercept_errors off;

		# Subir una imagen grande puede tardar más que el default de 60 s.
		proxy_read_timeout 120s;
		proxy_send_timeout 120s;
	}
}
