# Copiar a .env y cambiar los passwords. .env no se versiona.
MYSQL_DATABASE=la_liga_acp
MYSQL_USER=liga
MYSQL_PASSWORD=cambiar_password_app
MYSQL_ROOT_PASSWORD=cambiar_password_root
# Puerto publicado en el host.
MYSQL_PORT=3306

# --- Backend (server/) ---
# Puerto del backend (mismo puerto por dentro del contenedor y publicado al host).
PORT=3001
# Origen exacto permitido por CORS. Debe ser el del frontend en desarrollo.
CORS_ORIGIN=http://localhost:5173
# Host y puerto donde el backend busca MySQL cuando corre en el host (fuera
# de Docker): DB_PORT debe coincidir con MYSQL_PORT si lo cambiás arriba.
# docker compose (servicio server) ignora estos dos y usa la red interna
# (db:3306) — ver compose.yaml.
DB_HOST=127.0.0.1
DB_PORT=3306
# Segunda base, solo para las pruebas automatizadas (Vitest). Se crea y se
# migra sola al correr "npm test" en server/; nunca lleva datos reales.
# Tiene que ser distinta de MYSQL_DATABASE (si no, el backend no arranca).
MYSQL_DATABASE_TEST=la_liga_acp_test

# Secreto para firmar los tokens CSRF de las sesiones. Obligatorio, mínimo 32
# caracteres, distinto en cada entorno y nunca versionado. El valor de abajo es
# un ejemplo y el backend lo rechaza a propósito. Generalo con:
#   openssl rand -base64 48
#   (o: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
SESSION_SECRET=cambiar_por_un_secreto_largo_y_aleatorio_de_32+_caracteres

# Opcionales: si no se definen, el backend usa estos valores por defecto.
# development | test | production (Vitest fuerza test por su cuenta).
# NODE_ENV=development
# Conexiones máximas del pool de MySQL.
# DB_POOL_SIZE=10
# Límite de peticiones por IP: RATE_LIMIT_MAX cada RATE_LIMIT_WINDOW_MS
# milisegundos (15 minutos). GET /health no cuenta.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
# Duración de una sesión, en horas (vencimiento absoluto, máximo 720).
# SESSION_TTL_HOURS=12
# Intentos de login fallidos permitidos por IP + correo en la ventana (15 min).
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# LOGIN_RATE_LIMIT_MAX=5
# Registros permitidos por IP en la ventana (1 hora), exitosos o no.
# REGISTER_RATE_LIMIT_WINDOW_MS=3600000
# REGISTER_RATE_LIMIT_MAX=10
# API pública de solo lectura (/public): límite propio por IP, más holgado.
# PUBLIC_RATE_LIMIT_WINDOW_MS=60000
# PUBLIC_RATE_LIMIT_MAX=120
# Proxies de confianza para leer la IP real del cliente (X-Forwarded-For).
# Por defecto false: se usa la IP de la conexión. Detrás de un proxy, poné la
# cantidad de proxies (1) o sus IPs/rangos (loopback, 10.0.0.0/8, ...).
# "true" se rechaza: permitiría a cualquiera falsear su IP y evadir los límites.
# TRUST_PROXY=false
