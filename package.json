{
  "name": "la-liga-acp",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "server:install": "npm --prefix server install",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:test": "npm --prefix server test",
    "server:typecheck": "npm --prefix server run typecheck",
    "server:admin:create": "npm --prefix server run admin:create",
    "server:coins:check": "npm --prefix server run coins:check",
    "server:seed:dev": "npm --prefix server run seed:dev --",
    "server:seed:dev:clean": "npm --prefix server run seed:dev:clean --",
    "server:start": "npm --prefix server start"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
