# Imagen de producción del FRONT: compila la SPA y la sirve con un nginx
# interno que además reenvía /api al backend por la red de Compose. Es la única
# puerta de entrada de la pila (compose.prod.yaml la publica solo en el
# loopback del host), así que el nginx del HOST no necesita Node, ni dist/, ni
# las rutas de la SPA: solo pone el TLS y reenvía todo a ese puerto.
# Ver deploy/web/nginx.conf y el README, "Despliegue en servidor propio".

# ---------- build ----------
# glibc (bookworm) y no alpine: el build usa binarios nativos (TypeScript 7,
# rolldown, lightningcss, sharp) y sus paquetes glibc son los más probados.
# Esta etapa no llega a la imagen final, así que su tamaño no importa.
FROM node:22-bookworm-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

# Lo que leen `tsc -b` (tsconfig.app.json incluye src, tsconfig.node.json los
# archivos de configuración) y `vite build`. vercel.json va porque el build
# falla si no coincide con SPA_ROUTES.
COPY tsconfig.json tsconfig.app.json tsconfig.node.json ./
COPY vite.config.ts vitest.config.ts vercel.json index.html ./
COPY vite-plugins ./vite-plugins
COPY public ./public
COPY src ./src

# Deja dist/ y, fuera de dist/, deploy/nginx/spa-routes.conf generado desde
# SPA_ROUTES en esta misma corrida: nunca puede quedar desfasado del front.
RUN npm run build

# ---------- runtime ----------
# nginx oficial sin privilegios: corre como el usuario nginx (uid 101) y
# escucha en el 8080, así que no hace falta root dentro del contenedor.
FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY deploy/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/deploy/nginx/spa-routes.conf /etc/nginx/liga/spa-routes.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080

# Solo el shell: no toca la API, para que el front no figure "unhealthy" por
# un problema de la base (eso ya lo dice el healthcheck del backend).
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
	CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
