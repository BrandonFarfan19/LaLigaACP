---
import { Image } from 'astro:assets';
import type { ResolvedMatch } from '../types';

interface Props {
	match: ResolvedMatch;
}

const { homeTeam, awayTeam, status, score, venue, kickoff } = Astro.props.match;

const kickoffDate = new Date(kickoff);

const dayLabel = new Intl.DateTimeFormat('es', {
	day: '2-digit',
	month: 'short',
	timeZone: 'America/Lima',
}).format(kickoffDate);

const timeLabel = new Intl.DateTimeFormat('es', {
	hour: '2-digit',
	minute: '2-digit',
	hour12: false,
	timeZone: 'America/Lima',
}).format(kickoffDate);

const statusLabel: Record<ResolvedMatch['status'], string> = {
	scheduled: 'Programado',
	live: 'En vivo',
	finished: 'Finalizado',
};

const played = status === 'finished' && score !== undefined;
---

<article class="match pixel-box" data-status={status}>
	<header class="meta">
		<span class="status">{statusLabel[status]}</span>
		<time datetime={kickoff}>{dayLabel} · {timeLabel}</time>
	</header>

	<div class="board">
		<div class="team">
			<Image
				class="crest pixelated"
				src={homeTeam.crest}
				alt={`Escudo de ${homeTeam.name}`}
				width={48}
				densities={[2]}
				loading="lazy"
			/>
			<span class="name">{homeTeam.shortName}</span>
		</div>

		<div class="result">
			{
				played ? (
					<span class="score">
						{score!.home}<span class="dash">-</span>{score!.away}
					</span>
				) : (
					<span class="versus">VS</span>
				)
			}
		</div>

		<div class="team">
			<Image
				class="crest pixelated"
				src={awayTeam.crest}
				alt={`Escudo de ${awayTeam.name}`}
				width={48}
				densities={[2]}
				loading="lazy"
			/>
			<span class="name">{awayTeam.shortName}</span>
		</div>
	</div>

	<footer class="venue">{venue}</footer>
</article>

<style>
	.match {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding: var(--space-4);
		/* Border, notched corners and drop shadow all come from `.pixel-box`
		   plus this offset — no radius, no blur anywhere. */
		background: var(--color-surface);
	}

	.meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2);
		font-size: var(--text-sm);
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.status {
		font-family: var(--font-display);
		font-size: var(--text-xs);
		padding: var(--space-1) var(--space-2);
		background: var(--color-surface-raised);
		box-shadow: inset var(--px) var(--px) 0 0 rgb(255 255 255 / 0.12);
	}

	.match[data-status='finished'] .status {
		color: var(--color-accent);
	}

	.match[data-status='live'] .status {
		color: var(--color-danger);
		/* Two-frame blink, like a 90s scoreboard. */
		animation: blink 1s steps(1, end) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0.35;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.match[data-status='live'] .status {
			animation: none;
		}
	}

	.board {
		display: grid;
		/* Equal side columns keep the score optically centered even when one
		   team name is much longer than the other. */
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: var(--space-2);
	}

	.team {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-2);
		text-align: center;
	}

	.crest {
		width: 64px;
		height: 64px;
		object-fit: contain;
	}

	.name {
		font-family: var(--font-display);
		font-size: var(--text-xs);
		text-transform: uppercase;
		line-height: 1.5;
	}

	.result {
		min-width: 72px;
		text-align: center;
	}

	.score {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		font-family: var(--font-display);
		font-size: var(--text-lg);
		line-height: 1;
	}

	.dash {
		color: var(--color-text-muted);
	}

	.versus {
		display: inline-block;
		font-family: var(--font-display);
		font-size: var(--text-md);
		color: var(--color-accent-alt);
	}

	.venue {
		font-size: var(--text-sm);
		text-transform: uppercase;
		color: var(--color-text-muted);
		text-align: center;
	}

	@media (min-width: 48rem) {
		.match {
			padding: var(--space-6);
		}

		.crest {
			width: 80px;
			height: 80px;
		}

		.name {
			font-size: var(--text-sm);
		}

		.score {
			font-size: var(--text-xl);
		}
	}
</style>
