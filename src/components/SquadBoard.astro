---
import { Image } from 'astro:assets';
import pitch from '../assets/backgrounds/cancha-vertical.png';
import PlayerStatsDialog from './PlayerStatsDialog.astro';
import type { Player, PlayerStats, ResolvedSquadPlacement } from '../types';

/**
 * A team's squad: the pitch on one side, the roster table on the other.
 * Stacked on a phone, side by side from 48rem up. Each name opens that
 * player's stats card.
 */
interface Props {
	players: Player[];
	stats: PlayerStats[];
	placements: ResolvedSquadPlacement[];
}

const { players, stats, placements } = Astro.props;

const statsByPlayer = new Map(stats.map((row) => [row.playerId, row]));
const dialogId = (player: Player) => `stats-${player.id}`;
---

<div class="board">
	<figure class="pitch">
		<div class="pitch-field">
		<Image
			class="pitch-art pixelated"
			src={pitch}
			alt=""
			width={240}
			densities={[2]}
			loading="lazy"
		/>
		<ul class="pitch-players" aria-label="Jugadores en la cancha">
			{placements.map(({ player, shirtNumber, x, y }) => (
				<li class="pitch-position" style={`--x: ${x}%; --y: ${y}%`}>
					<button
						class="pitch-player"
						type="button"
						disabled={!statsByPlayer.has(player.id)}
						aria-label={`Ver estadísticas de ${player.name}, dorsal de muestra ${shirtNumber}`}
						aria-haspopup="dialog"
						aria-controls={statsByPlayer.has(player.id) ? dialogId(player) : undefined}
						data-stats-open={statsByPlayer.has(player.id) ? dialogId(player) : undefined}
					>
						<span class="sprite" aria-hidden="true">
							<svg viewBox="0 0 16 24" shape-rendering="crispEdges">
								<path class="sprite-shadow" d="M3 22h10v2H3z" />
								<path class="sprite-head" d="M5 1h6v6H5z" />
								<path class="sprite-hair" d="M5 0h6v3H5zM4 1h1v4H4zM11 1h1v4h-1z" />
								<path class="sprite-shirt" d="M4 7h8v2h2v6h-3v2H5v-2H2V9h2z" />
								<path class="sprite-head" d="M2 15h3v2H2zM11 15h3v2h-3z" />
								<path class="sprite-shorts" d="M5 17h6v3H5z" />
								<path class="sprite-socks" d="M5 20h2v2H5zM9 20h2v2H9z" />
								<path class="sprite-hair" d="M4 22h3v1H4zM9 22h3v1H9z" />
							</svg>
							<span class="shirt-number">{shirtNumber}</span>
						</span>
						<span class="pitch-name">{player.name}</span>
					</button>
				</li>
			))}
		</ul>
		</div>
		<p class="pitch-hint">Toca un jugador para ver su ficha</p>
	</figure>

	<table class="roster pixel-box">
		<caption class="caption">Plantilla</caption>
		<thead>
			<tr>
				<th scope="col">Jugador</th>
			</tr>
		</thead>
		<tbody>
			{
				players.map((player) => (
					<tr>
						<td>
							{statsByPlayer.has(player.id) ? (
								<button
									class="player"
									type="button"
									aria-haspopup="dialog"
									data-stats-open={dialogId(player)}
								>
									{player.name}
								</button>
							) : (
								player.name
							)}
						</td>
					</tr>
				))
			}
		</tbody>
	</table>
</div>

{
	players.map((player) => {
		const playerStats = statsByPlayer.get(player.id);
		return playerStats && <PlayerStatsDialog id={dialogId(player)} player={player} stats={playerStats} />;
	})
}

<script>
	for (const trigger of document.querySelectorAll<HTMLElement>('[data-stats-open]')) {
		const dialog = document.getElementById(trigger.dataset.statsOpen ?? '');
		if (!(dialog instanceof HTMLDialogElement)) continue;

		trigger.addEventListener('click', () => dialog.showModal());
	}

	for (const dialog of document.querySelectorAll<HTMLDialogElement>('dialog[data-player-card]')) {
		// A click that lands on the dialog element itself hit the backdrop.
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});
	}

	// A shared link (`#stats-<player id>`) lands straight on that player's card.
	const shared = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
	if (shared instanceof HTMLDialogElement && shared.matches('[data-player-card]')) shared.showModal();
</script>

<style>
	/* Phone: one column, pitch above the roster. */
	.board {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-6);
		width: 100%;
		max-width: 72rem;
	}

	.pitch {
		margin: 0;
		flex-shrink: 0;
		width: 100%;
		max-width: 384px;
	}

	.pitch-hint {
		font-family: var(--font-body);
		font-size: var(--text-md);
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	.pitch-hint {
		margin: 0;
		padding: var(--space-2);
		background: var(--color-surface);
	}

	.pitch-field {
		position: relative;
		box-shadow: var(--px) var(--px) 0 0 var(--color-shadow);
	}

	.pitch-art {
		display: block;
		width: 100%;
		height: auto;
	}

	.pitch-players {
		position: absolute;
		inset: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.pitch-position {
		position: absolute;
		left: var(--x);
		top: var(--y);
		width: 24%;
		transform: translate(-50%, -50%);
	}

	.pitch-player {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-2);
		width: 100%;
		min-width: 44px;
		min-height: 44px;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--color-text);
		font-family: var(--font-display);
		font-size: var(--text-xs);
		font-weight: 400;
		line-height: 1.5;
	}

	.sprite {
		position: relative;
		display: block;
		width: 48px;
		height: 72px;
		transition: transform 120ms steps(2, end);
	}

	.sprite svg { display: block; width: 100%; height: 100%; }
	.sprite-shadow, .sprite-hair { fill: var(--color-shadow); }
	.sprite-head { fill: var(--color-text-muted); }
	.sprite-shirt { fill: var(--team-accent, var(--color-accent)); }
	.sprite-shorts { fill: var(--color-surface); }
	.sprite-socks { fill: var(--color-text); }

	.shirt-number {
		position: absolute;
		top: 24px;
		left: 12px;
		width: 24px;
		line-height: 24px;
		color: var(--color-shadow);
	}

	.pitch-name {
		display: block;
		width: 100%;
		padding: var(--space-2) 0;
		background: var(--color-surface);
		box-shadow: 0 var(--px) 0 var(--color-shadow);
		overflow-wrap: anywhere;
	}

	.pitch-player:focus-visible .sprite {
		transform: translateY(calc(-1 * var(--px)));
	}

	.pitch-player:focus-visible .pitch-name {
		color: var(--color-accent-alt);
	}

	.pitch-player:disabled { opacity: 0.65; }

	@media (hover: hover) {
		.pitch-player:hover:not(:disabled) .sprite {
			transform: translateY(calc(-1 * var(--px)));
		}
		.pitch-player:hover:not(:disabled) .pitch-name { color: var(--color-accent-alt); }
	}

	@media (prefers-reduced-motion: reduce) {
		.sprite { transition: none; }
	}

	.roster {
		width: 100%;
		border-collapse: collapse;
		background: var(--color-surface);
		text-align: left;
	}

	.caption {
		padding-block-end: var(--space-2);
		font-family: var(--font-display);
		font-size: var(--text-xs);
		text-transform: uppercase;
		text-align: left;
		color: var(--color-text-muted);
	}

	.roster th[scope='col'] {
		padding: var(--space-3);
		background: var(--color-surface-raised);
		font-family: var(--font-display);
		font-weight: 400;
		font-size: var(--text-xs);
		text-transform: uppercase;
		color: var(--color-accent);
		box-shadow: inset var(--px) var(--px) 0 0 rgb(255 255 255 / 0.12);
	}

	.roster td {
		padding: var(--space-3);
		font-size: var(--text-sm);
	}

	/* The whole cell is the hit area; the padding moves onto the button so
	   the row is at least 44px tall to tap. */
	.roster td:has(.player) {
		padding: 0;
	}

	.player {
		display: block;
		width: 100%;
		min-height: 44px;
		padding: var(--space-3);
		border: 0;
		background: none;
		font: inherit;
		color: inherit;
		text-align: left;
	}

	.player:hover,
	.player:focus-visible {
		color: var(--color-accent-alt);
	}

	/* The menu cursor, same as the navbar links. */
	.player::before {
		content: '\25B8';
		margin-right: var(--space-1);
		opacity: 0;
	}

	.player:hover::before,
	.player:focus-visible::before {
		opacity: 1;
	}

	/* Banded rows, the way a 16-bit menu lists entries. No separator lines:
	   a `--px` rule between seven rows reads as a cage. */
	.roster tbody tr:nth-child(even) {
		background: var(--color-surface-raised);
	}

	.roster tbody tr {
		transition: background-color 120ms steps(2, end);
	}

	/* Highlighted entry, like the cursor row of a menu. The lightest blue in
	   the palette keeps the white text at roughly 6:1 contrast. Gated on real
	   hover so a tap on a phone doesn't leave a row stuck lit. */
	@media (hover: hover) {
		.roster tbody tr:hover {
			background: var(--color-border);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.roster tbody tr {
			transition: none;
		}
	}

	@media (min-width: 48rem) {
		.board {
			flex-direction: row;
			/* Pitch and roster are never the same height, so they ride on a
			   shared center line instead of a shared top edge. */
			align-items: center;
			gap: var(--space-8);
		}

		.pitch {
			width: 48%;
		}

		.roster {
			/* Takes whatever the pitch leaves. */
			flex: 1;
		}

		.roster td {
			font-size: var(--text-md);
		}
	}
</style>
