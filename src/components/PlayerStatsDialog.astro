---
import { Image } from 'astro:assets';
// Placeholder portrait shared by every player until real photos exist.
import portrait from '../assets/jugadoresPixel/futbol/jugador-marron-claro-fifa2002.png';
import { GRID, radarLabels, rasterizeRadar } from '../utils/pixel-radar';
import type { Player, PlayerStatKey, PlayerStats } from '../types';

/**
 * A player's attribute card: portrait, pixel radar and the numbers behind
 * it, in a native modal `<dialog>`. Opened by any element carrying
 * `data-stats-open="<this dialog's id>"`, or by landing on the page with
 * `#<this dialog's id>` — the link the share buttons hand out. The shared
 * image is a capture of this dialog itself.
 */
interface Props {
	id: string;
	player: Player;
	stats: PlayerStats;
}

const { id, player, stats } = Astro.props;

// Axis order around the radar, clockwise from the top.
const ATTRIBUTES: { key: PlayerStatKey; short: string; label: string }[] = [
	{ key: 'shooting', short: 'DIS', label: 'Disparo' },
	{ key: 'passing', short: 'PAS', label: 'Pase' },
	{ key: 'strength', short: 'FUE', label: 'Fuerza' },
	{ key: 'defense', short: 'DEF', label: 'Defensa' },
	{ key: 'speed', short: 'VEL', label: 'Velocidad' },
	{ key: 'dribbling', short: 'DRI', label: 'Dribbling' },
];

const values = ATTRIBUTES.map((attribute) => stats[attribute.key]);
const average = Math.round(values.reduce((sum, value) => sum + value, 0) / values.length);
const runs = rasterizeRadar(values);
const labels = radarLabels(ATTRIBUTES.length);
const titleId = `${id}-title`;
---

<dialog class="stats pixel-box" id={id} aria-labelledby={titleId} data-player-card data-player-id={player.id}>
	<header class="head">
		<div>
			<h2 class="name" id={titleId}>{player.name}</h2>
			<p class="average">Media <span class="average-value">{average}</span></p>
		</div>
		<form method="dialog" data-capture-exclude>
			<button class="close" aria-label="Cerrar">X</button>
		</form>
	</header>

	<div class="body">
		{/* Rendered small and upscaled ×2 by CSS: real pixel art. */}
		<figure class="portrait pixel-bevel">
			<Image class="portrait-art pixelated" src={portrait} alt="" width={96} loading="eager" data-card-portrait />
		</figure>

		{/* Decorative: the table below carries every value. */}
		<div class="radar" aria-hidden="true">
			<svg viewBox={`0 0 ${GRID} ${GRID}`} shape-rendering="crispEdges">
				{runs.map((run) => <rect class={run.kind} x={run.x} y={run.y} width={run.width} height="1" />)}
			</svg>
			{
				ATTRIBUTES.map((attribute, i) => (
					<span class="axis" style={`left: ${labels[i].left}%; top: ${labels[i].top}%`}>
						{attribute.short}
					</span>
				))
			}
		</div>

		<table class="values">
			<caption class="visually-hidden">Estadísticas de {player.name}</caption>
			<tbody>
				{
					ATTRIBUTES.map((attribute) => (
						<tr style={`--value: ${stats[attribute.key]}`}>
							<th scope="row">{attribute.label}</th>
							<td>{stats[attribute.key]}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>

	{/* Left out of the captured image. Hidden until the script runs:
	    sharing needs JavaScript. */}
	<footer class="share-bar" data-capture-exclude data-share hidden>
		<p class="share-title">Compartir</p>
		<div class="share-grid">
			<button class="share-option" type="button" data-share-to="whatsapp">WhatsApp</button>
			<button class="share-option" type="button" data-share-to="facebook">Facebook</button>
			<button class="share-option" type="button" data-share-to="instagram" hidden>Instagram</button>
			<button class="share-option" type="button" data-share-copy>Copiar enlace</button>
		</div>
		<p class="share-status" role="status" data-share-status></p>
	</footer>
</dialog>

<script>
	import { captureElement } from '../utils/share-image';

	/** Desktop: the networks only take a link, so they get the team page's. */
	const WEB_SHARE: Record<string, ((url: string, text: string) => string) | undefined> = {
		whatsapp: (url, text) => `https://wa.me/?text=${encodeURIComponent(`${text} ${url}`)}`,
		facebook: (url) => `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`,
	};

	/**
	 * A phone with a share sheet that takes files. Only then does sharing
	 * carry the image; everywhere else it is the team link alone.
	 */
	const probe = new File([''], 'probe.png', { type: 'image/png' });
	const sharesImages = matchMedia('(pointer: coarse)').matches && Boolean(navigator.canShare?.({ files: [probe] }));

	const teamName = document.querySelector('h1')?.textContent?.trim() ?? '';
	const teamUrl = `${location.origin}${location.pathname}`;
	const teamText = `Plantilla de ${teamName} en La Liga ACP`;

	for (const dialog of document.querySelectorAll<HTMLDialogElement>('dialog[data-player-card]')) {
		const bar = dialog.querySelector<HTMLElement>('[data-share]');
		const status = dialog.querySelector<HTMLElement>('[data-share-status]');
		if (!bar || !status) continue;

		const name = dialog.querySelector('h2')?.textContent?.trim() ?? '';
		const average = dialog.querySelector('.average-value')?.textContent?.trim() ?? '';
		const playerText = `${name} · Media ${average} en La Liga ACP`;
		// On a phone the link opens this player's card; on desktop it is the team page.
		const url = sharesImages ? `${teamUrl}#${dialog.id}` : teamUrl;
		const fileName = `la-liga-acp-${dialog.dataset.playerId}.png`;

		const say = (message: string) => {
			status.textContent = message;
		};

		// Captured as soon as the dialog opens, so by the time a button is
		// tapped the file is ready and the share sheet still counts as a
		// response to that tap.
		let image: Promise<File> | null = null;
		const getImage = () =>
			(image ??= captureElement(dialog)
				.then((blob) => new File([blob], fileName, { type: 'image/png' }))
				.catch((error) => {
					image = null;
					throw error;
				}));

		if (sharesImages) {
			new MutationObserver(() => {
				if (dialog.open) getImage().catch(() => {});
			}).observe(dialog, { attributes: true, attributeFilter: ['open'] });
		}

		bar.hidden = false;
		// Instagram has no web share link: it only takes the image from the phone's sheet.
		const instagram = bar.querySelector<HTMLElement>('[data-share-to="instagram"]');
		if (instagram) instagram.hidden = !sharesImages;

		for (const button of bar.querySelectorAll<HTMLButtonElement>('[data-share-to]')) {
			const network = button.dataset.shareTo ?? '';

			button.addEventListener('click', async () => {
				say('');

				if (!sharesImages) {
					const target = WEB_SHARE[network];
					if (target) window.open(target(teamUrl, teamText), '_blank', 'noopener,noreferrer');
					return;
				}

				try {
					const file = await getImage();
					// Instagram drops shares that carry text; the others use it as the caption.
					await navigator.share(network === 'instagram' ? { files: [file] } : { files: [file], text: `${playerText} ${url}` });
				} catch (error) {
					if (!(error instanceof DOMException && error.name === 'AbortError')) say('No se pudo compartir');
				}
			});
		}

		bar.querySelector('[data-share-copy]')?.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(url);
				say('¡Enlace copiado!');
			} catch {
				say(url);
			}
		});

		dialog.addEventListener('close', () => say(''));
	}
</script>

<style>
	.stats {
		/* Phone: nearly full width, keeping the 16px gutter. */
		width: calc(100% - var(--space-8));
		max-width: 24rem;
		max-height: calc(100svh - var(--space-8));
		padding: var(--space-4);
		border: 0;
		color: var(--color-text);
		overflow-y: auto;
	}

	/* Flat dim, no blur. */
	.stats::backdrop {
		background: color-mix(in srgb, var(--color-shadow) 80%, transparent);
	}

	.head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-3);
		text-align: left;
	}

	.name {
		font-size: var(--text-sm);
		text-shadow: var(--px) var(--px) 0 var(--color-shadow);
	}

	.average {
		margin: var(--space-2) 0 0;
		font-size: var(--text-sm);
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.average-value {
		font-family: var(--font-display);
		color: var(--color-accent-alt);
	}

	.close {
		flex-shrink: 0;
		width: 44px;
		height: 44px;
		border: 0;
		background: var(--color-surface-raised);
		font-family: var(--font-display);
		font-size: var(--text-sm);
		color: var(--color-text);
		box-shadow:
			inset var(--px) var(--px) 0 0 rgb(255 255 255 / 0.16),
			inset calc(var(--px) * -1) calc(var(--px) * -1) 0 0 var(--color-shadow);
	}

	.close:hover,
	.close:focus-visible {
		color: var(--color-accent);
	}

	.body {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-4);
		margin-top: var(--space-4);
	}

	/* 96px art at exactly 2×, so every source pixel is a clean 2×2 block. */
	.portrait {
		flex-shrink: 0;
		width: 192px;
		height: 192px;
		margin: 0;
		background: var(--color-surface-raised);
	}

	.portrait-art {
		display: block;
		width: 100%;
		height: 100%;
	}

	/* 240px over an 80-cell grid: every radar pixel is exactly 3px. */
	.radar {
		position: relative;
		width: 240px;
		max-width: 100%;
		aspect-ratio: 1;
	}

	.radar svg {
		display: block;
		width: 100%;
		height: 100%;
	}

	.disc {
		fill: var(--color-surface-raised);
	}

	.ring {
		fill: var(--color-border);
	}

	.fill {
		fill: color-mix(in srgb, var(--color-accent-alt) 35%, var(--color-surface-raised));
	}

	.edge {
		fill: var(--color-accent-alt);
	}

	.axis {
		position: absolute;
		transform: translate(-50%, -50%);
		font-family: var(--font-display);
		font-size: var(--text-xs);
		line-height: 1;
		color: var(--color-text-muted);
	}

	.values {
		width: 100%;
		border-collapse: collapse;
	}

	.values th,
	.values td {
		padding: var(--space-2) 0;
		/* Stepped underline instead of a hairline rule. */
		box-shadow: inset 0 calc(var(--px) * -1) 0 0 var(--color-border);
	}

	.values th {
		font-family: var(--font-body);
		font-weight: 400;
		font-size: var(--text-sm);
		text-align: left;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.values td {
		font-family: var(--font-display);
		font-size: var(--text-md);
		text-align: right;
		color: var(--color-text);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* ---- Share ------------------------------------------------------------ */

	.share-bar {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		margin-top: var(--space-6);
	}

	.share-option {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		min-height: 44px;
		padding: var(--space-2) var(--space-3);
		border: 0;
		background: var(--color-surface-raised);
		font-family: var(--font-display);
		font-weight: 400;
		font-size: var(--text-xs);
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-text);
		box-shadow:
			inset var(--px) var(--px) 0 0 rgb(255 255 255 / 0.16),
			inset calc(var(--px) * -1) calc(var(--px) * -1) 0 0 var(--color-shadow);
		transition: color 120ms steps(2, end);
	}

	.share-option:hover,
	.share-option:focus-visible {
		color: var(--color-accent-alt);
	}

	/* Pressed: the bevel flips, the way a 16-bit button sinks. */
	.share-option:active {
		box-shadow:
			inset var(--px) var(--px) 0 0 var(--color-shadow),
			inset calc(var(--px) * -1) calc(var(--px) * -1) 0 0 rgb(255 255 255 / 0.16);
	}

	/* The display rules here would otherwise beat the `hidden` attribute. */
	.share-bar[hidden],
	.share-option[hidden] {
		display: none;
	}

	.share-title {
		margin: 0 0 var(--space-2);
		font-size: var(--text-sm);
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.share-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.share-status {
		min-height: var(--space-4);
		margin: 0;
		font-size: var(--text-sm);
		color: var(--color-accent);
		overflow-wrap: anywhere;
	}

	.share-status:empty {
		display: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.share-option {
			transition: none;
		}
	}

	@media (min-width: 48rem) {
		.stats {
			max-width: 56rem;
			padding: var(--space-6);
		}

		.name {
			font-size: var(--text-md);
		}

		.body {
			flex-direction: row;
			gap: var(--space-6);
		}

		/* One row, however many buttons are showing (Instagram is phone-only). */
		.share-grid {
			grid-template-columns: none;
			grid-auto-flow: column;
			grid-auto-columns: 1fr;
		}

		/* 320px over 80 cells: 4px radar pixels, one `--px` each. */
		.radar {
			width: 320px;
			flex-shrink: 0;
		}

		.axis {
			font-size: var(--text-sm);
		}
	}
</style>
