---
import { getImage } from 'astro:assets';
import Navbar from '../components/Navbar.astro';
import bgLandscape from '../assets/backgrounds/estadio-aficion.png';
import bgPortrait from '../assets/backgrounds/estadio-aficion-vertical.png';
import '../styles/global.css';

interface Props {
	/** Page title. The site name is appended here, not at each call site. */
	title: string;
}

const { title } = Astro.props;

// Rendered small and upscaled by CSS with nearest-neighbour, like every other
// image here — it is what makes the crowd read as a tiled background rather
// than a photo sitting behind pixel art.
const bgDesktop = await getImage({ src: bgLandscape, width: 480, format: 'webp' });
const bgMobile = await getImage({ src: bgPortrait, width: 240, format: 'webp' });
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		{/* Art direction: the portrait crop on phones, the landscape one from
		    48rem up. `<source media>` means only one of the two is downloaded. */}
		<picture class="backdrop" aria-hidden="true">
			<source media="(min-width: 48rem)" srcset={bgDesktop.src} />
			<img
				class="pixelated"
				src={bgMobile.src}
				alt=""
				width={bgMobile.attributes.width ?? 240}
				height={bgMobile.attributes.height ?? 426}
				loading="eager"
				fetchpriority="high"
			/>
		</picture>

		<Navbar />
		<main>
			<slot />
		</main>
	</body>
</html>

<style>
	/* Pinned to the viewport so the stadium stays put while the page
	   scrolls over it, on every route. */
	.backdrop {
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
	}

	.backdrop img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Darkens the crowd so content stays readable on top of it. Banded
	   stops, never a continuous gradient. */
	.backdrop::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to bottom,
			color-mix(in srgb, var(--color-bg) 92%, transparent) 0 18%,
			color-mix(in srgb, var(--color-bg) 82%, transparent) 18% 42%,
			color-mix(in srgb, var(--color-bg) 74%, transparent) 42% 68%,
			color-mix(in srgb, var(--color-bg) 84%, transparent) 68% 88%,
			color-mix(in srgb, var(--color-bg) 94%, transparent) 88% 100%
		);
	}

	/* Content paints above the backdrop. */
	main {
		position: relative;
		z-index: 1;
	}
</style>
