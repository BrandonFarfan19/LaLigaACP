---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SquadBoard from '../../components/SquadBoard.astro';
import { getPlayersByTeamId, getPlayerStatsByTeamId, getSquadPlacementsByTeamId } from '../../lib/players';
import { getTeams } from '../../lib/teams';
import type { Player, PlayerStats, Team, ResolvedSquadPlacement } from '../../types';

/**
 * One static page per team, generated at build time from the data layer.
 * When the backend arrives this keeps working untouched: `getTeams()` starts
 * returning rows from the API and the same routes get built.
 */
export async function getStaticPaths() {
	const teams = await getTeams();

	return Promise.all(
		teams.map(async (team) => ({
			params: { id: team.id },
			props: {
				team,
				players: await getPlayersByTeamId(team.id),
				stats: await getPlayerStatsByTeamId(team.id),
				placements: await getSquadPlacementsByTeamId(team.id),
			},
		})),
	);
}

interface Props {
	team: Team;
	players: Player[];
	stats: PlayerStats[];
	placements: ResolvedSquadPlacement[];
}

const { team, players, stats, placements } = Astro.props;
---

<Base title={`Plantilla · ${team.name}`}>
	<section class="squad" style={`--team-accent: ${team.accent}`}>
		<a class="back" href="/#inicio">&lt; Volver</a>

		<header class="identity">
			<div class="badge">
				<Image
					class="crest pixelated"
					src={team.crest}
					alt={`Escudo de ${team.name}`}
					width={32}
					densities={[2]}
					loading="eager"
					fetchpriority="high"
				/>
			</div>

			<h1 class="name">{team.name}</h1>
		</header>

		<SquadBoard players={players} stats={stats} placements={placements} />
	</section>
</Base>

<style>
	.squad {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-6);
		min-height: 100vh;
		min-height: 100svh;
		padding-block: calc(var(--navbar-height) + var(--space-8)) var(--space-12);
		padding-inline: var(--space-4);
		text-align: center;
	}

	.back {
		align-self: flex-start;
		font-family: var(--font-display);
		font-size: var(--text-xs);
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-text-muted);
		transition: color 120ms steps(2, end);
	}

	.back:hover,
	.back:focus-visible {
		color: var(--color-accent);
	}

	/* Same stage treatment as the carousel, tinted with the team color. The
	   stage takes its size from the crest inside it, so the glow always ends
	   exactly where the artwork does. */
	.badge {
		display: flex;
		align-items: center;
		justify-content: center;
		/* A long team name must not squeeze the crest out of square. */
		flex-shrink: 0;
		background: radial-gradient(
			circle closest-side,
			color-mix(in srgb, var(--team-accent) 42%, transparent) 0 30%,
			color-mix(in srgb, var(--team-accent) 26%, transparent) 30% 50%,
			color-mix(in srgb, var(--team-accent) 12%, transparent) 50% 70%,
			transparent 70%
		);
	}

	.crest {
		width: 5vw;
		height: 5vw;
		object-fit: contain;
		filter: drop-shadow(var(--px) var(--px) 0 var(--color-shadow));
	}

	/* Crest and name read as one line, not as a stacked title block. */
	.identity {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}

	.name {
		font-size: var(--text-md);
		line-height: 1.4;
		text-shadow: var(--px) var(--px) 0 var(--color-shadow);
	}

	@media (min-width: 48rem) {
		.name {
			font-size: var(--text-lg);
		}
	}
</style>
